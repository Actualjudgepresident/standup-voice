{
  "name": "standup-voice",
  "version": "0.2.0",
  "description": "Voice standup assistant for Alexa+: an MCP server (Streamable HTTP) that builds your daily standup from GitHub activity and spoken notes.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "standup-voice": "src/server.ts",
    "standupbee": "src/cli.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "serve": "node src/server.ts",
    "start": "node src/server.ts",
    "demo": "node src/cli.ts run --source fixtures --extractor rules",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "latest",
    "@anthropic-ai/sdk": "latest",
    "@beeai/cli": "^0.7.3",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
