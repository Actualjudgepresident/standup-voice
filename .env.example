# Which LLM runs extraction: anthropic | bedrock | rules (offline, no key)
STANDUPBEE_EXTRACTOR=anthropic
ANTHROPIC_API_KEY=
# Bedrock (AWS Builder mini-challenge): uses your normal AWS credentials
AWS_REGION=us-east-1
STANDUPBEE_BEDROCK_MODEL=anthropic.claude-opus-5-5
# GitHub issue creation (only with --apply). Falls back to `gh auth token`.
GITHUB_TOKEN=
STANDUPBEE_REPO=owner/repo
